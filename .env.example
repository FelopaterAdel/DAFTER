# Daftar environment — copy to `.env` and edit.
#   cp .env.example .env

# SQLite database file.
# Development: keep it relative to the project (file:./prisma/dev.db).
# Production: use an absolute path on a persistent volume (file:/data/daftar.db).
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies. REQUIRED in production — the app refuses
# to start without it. Generate with:  openssl rand -hex 32
AUTH_SECRET=""

# Optional (defaults shown). The port the app listens on and the address Caddy
# or systemd should point at.
# PORT="3000"
# HOSTNAME="127.0.0.1"
